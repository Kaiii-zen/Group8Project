/* General CSS */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: white;
  color: #111;
}

.app {
  width: 100%;
}


/* Navigation Bar */
.navbar {
  height: 72px;
  background: #0756c9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 50px;
  color: white;
}

.logo {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: 1px;
}

.nav-links {
  display: flex;
  gap: 35px;
}

.nav-links a {
  color: white;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

.nav-links a.active {
  border-bottom: 2px solid white;
  padding-bottom: 8px;
}

.nav-buttons {
  display: flex;
  gap: 15px;
}

.login-btn,
.register-btn {
  padding: 12px 25px;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
}

.login-btn {
  background: transparent;
  color: white;
  border: 1px solid white;
}

.register-btn {
  background: white;
  color: #0756c9;
  border: 1px solid white;
}


/* Hero Section */
.hero {
  min-height: 500px;
  display: flex;
  align-items: center;
  text-align: left;

  background:
    linear-gradient(
      to right,
      rgba(255,255,255,1) 0%,
      rgba(255,255,255,0.97) 38%,
      rgba(255,255,255,0.70) 60%,
      rgba(255,255,255,0.1) 100%
    ),
    url("/property_building.png");

  background-size: cover;
  background-position: center right;
}

.hero-content {
  max-width: 650px;
  padding: 60px 50px;
  text-align: left;
}

.hero h1 {
  font-size: 44px;
  line-height: 1.05;
  margin-bottom: 25px;
  font-weight: 800;
  color: #111111;
}

.hero h1 span {
  color: #0756c9;
}

.hero p {
  font-size: 17px;
  line-height: 1.6;
  margin-bottom: 25px;
  max-width: 560px;
}

.hero-buttons {
  display: flex;
  gap: 18px;
  margin-bottom: 20px;
}

.primary-btn,
.secondary-btn {
  padding: 14px 25px;
  font-size: 14px;
  font-weight: 700;
  border-radius: 4px;
  cursor: pointer;
}

.primary-btn {
  background: #0756c9;
  color: white;
  border: 2px solid #0756c9;
}

.secondary-btn {
  background: white;
  color: #0756c9;
  border: 2px solid #0756c9;
}

.login-text {
  font-size: 14px !important;
}

.login-text a {
  color: #0756c9;
  font-weight: 700;
}


/* Features */
.features {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding: 40px 60px;
  background: white;
}

.feature-card {
  flex: 1;
  padding: 20px;
  text-align: center;
}

.feature-icon {
  width: 55px;
  height: 55px;
  background: #0756c9;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin: 0 auto 15px;
}

.feature-card h3 {
  font-size: 22px;
  margin-bottom: 8px;
}

.feature-card h4 {
  font-size: 18px;
  margin-bottom: 12px;
}

.feature-card p {
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 12px;
}

.feature-card a {
  color: #0756c9;
  font-weight: 600;
  text-decoration: underline;
}

/* Property Intelligence Section */
.intelligence-section {
  padding: 80px 60px;
  background: #f5f8fc;
}

.intelligence-content {
  max-width: 1200px;
  margin: 0 auto;
}

.intelligence-text {
  max-width: 850px;
}

.section-label {
  color: #0756c9;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 15px;
}

.intelligence-text h2 {
  font-size: 38px;
  line-height: 1.15;
  margin-bottom: 20px;
  color: #111111;
}

.intelligence-text > p {
  font-size: 17px;
  line-height: 1.6;
  max-width: 700px;
  margin-bottom: 35px;
}

.intelligence-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.intelligence-features > div {
  background: white;
  padding: 25px;
  border-radius: 6px;
  border: 1px solid #e1e7ef;
}

.intelligence-features h3 {
  color: #0756c9;
  font-size: 18px;
  margin-bottom: 10px;
}

.intelligence-features p {
  font-size: 14px;
  line-height: 1.5;
  color: #555555;
}


/* Property Listings Section */
.property-listings {
  padding: 80px 60px;
  background: white;
}

.listings-header {
  max-width: 1200px;
  margin: 0 auto 40px auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
}

.listings-header h2 {
  font-size: 38px;
  line-height: 1.2;
  margin-bottom: 15px;
  color: #111111;
}

.listings-header > div > p:last-child {
  max-width: 650px;
  font-size: 16px;
  line-height: 1.6;
  color: #555555;
}

.view-all {
  color: #0756c9;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

.view-all:hover {
  text-decoration: underline;
}


/* Property Cards */
.property-cards {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px
}

.property-card {
  background: white;
  border: 1px solid #e1e7ef;
  border-radius: 6px;
  overflow: hidden;
}

.property-card img {
  width: 100%;
  height: 210px;
  object-fit: cover;
  display: block;
}

.property-card-content {
  padding: 22px;
}

.property-type {
  color: #0756c9;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.property-card h3 {
  font-size: 20px;
  margin-bottom: 8px;
}

.property-location {
  color: #666666;
  font-size: 14px;
  margin-bottom: 18px;
}

.property-details {
  display: flex;
  gap: 15px;
  padding-bottom: 18px;
  border-bottom: 1px solid #e5e5e5;
  font-size: 13px;
  color: #555555;
}

.property-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding-top: 18px;
}

.property-bottom strong {
  font-size: 18px;
  color: #111111;
}

.property-bottom button {
  background: #0756c9;
  color: white;
  border: none;
  border-radius: 4px;
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.property-bottom button:hover {
  background: #0648a8;
}


/* Community Section */
.community-section {
  padding: 80px 60px;
  background: #f5f8fc;
}

.community-content {
  max-width: 1200px;
  margin: 0 auto;
}

.community-text {
  max-width: 1000px;
}

.community-text h2 {
  font-size: 38px;
  line-height: 1.15;
  margin-bottom: 20px;
  color: #111111;
}

.community-text > p:not(.section-label) {
  font-size: 17px;
  line-height: 1.6;
  max-width: 750px;
  margin-bottom: 40px;
  color: #444444; 
}

/* Community Feature Cards */
.community-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.community-feature {
  background: white;
  padding: 28px;
  border: 1px solid #e1e7ef;
  border-radius: 6px;
  transition: 0.2s ease;
}

.community-feature:hover {
  border-color: #0756c9;
  transform: translateY(-3px);
}

.community-feature h3 {
  color: #0756c9;
  font-size: 18px;
  margin-bottom: 10px;
}

.community-feature p {
  font-size: 14px;
  line-height: 1.6;
  color: #555555;
}

/* Community Section -Responsive */
@media (max-width: 900px) {

  .community-section {
    padding: 60px 40px;
  }

  .community-text h2 {
    font-size: 34px;
  }

  .community-features {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 650px) {

  .community-section {
    padding: 50px 25px;
  }

  .community-text h2 {
    font-size: 30px;
  }

  .community-text > p:not(.section-label) {
    font-size: 16px;
    margin-bottom: 30px;
  }

  .community-features {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .community-feature {
    padding: 22px;
  }
}

/* How VALORA Works */
.how-it-works {
  padding: 80px 60px;
  background: white;
}

.how-content {
  max-width: 1200px;
  margin: 0 auto;
}

.how-header {
  max-width: 750px;
  margin-bottom: 50px;
}

.how-header h2 {
  font-size: 38px;
  line-height: 1.15;
  margin-bottom: 20px;
  color: #111111;
}

.how-header > p:not(.section-label) {
  font-size: 17px;
  line-height: 1.6;
  color: #555555;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}

.step {
  padding: 25px;
  border-top: 3px solid #0756c9;
  background: #f5f8fc;
}

.step-number {
  color: #0756c9;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 20px;
}

.step h3 {
  font-size: 21px;
  margin-bottom: 12px;
}

.step p {
  font-size: 14px;
  line-height: 1.6;
  color: #555555;
}

/* How VALORA Works - Responsive */
@media (max-width: 900px) {

  .how-it-works {
    padding: 60px 40px;
  }

  .steps {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 650px) {

  .how-it-works {
    padding: 50px 25px;
  }

  .how-header h2 {
    font-size: 30px;
  }

  .steps {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  
}
